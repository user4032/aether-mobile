{
  "version": 2,
  "framework": null,
  "installCommand": "git clone https://github.com/flutter/flutter.git --depth 1 -b stable ../flutter ; ../flutter/bin/flutter --disable-analytics ; ../flutter/bin/flutter pub get",
  "buildCommand": "rm -rf build/web && ../flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/uk-ua/", "destination": "/uk-ua", "permanent": true },
    { "source": "/en-us/", "destination": "/en-us", "permanent": true }
  ],
  "rewrites": [
    { "source": "/uk-ua",          "destination": "/uk-ua.html" },
    { "source": "/uk-ua/:path*",   "destination": "/:path*" },
    { "source": "/uk-ua/download", "destination": "/download.html" },
    { "source": "/uk-ua/faq",      "destination": "/faq.html" },
    { "source": "/uk-ua/support",  "destination": "/support.html" },
    { "source": "/en-us",          "destination": "/en-us.html" },
    { "source": "/en-us/:path*",   "destination": "/:path*" },
    { "source": "/en-us/download", "destination": "/download.html" },
    { "source": "/en-us/faq",      "destination": "/faq.html" },
    { "source": "/en-us/support",  "destination": "/support.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/faq",      "destination": "/faq.html" },
    { "source": "/support",  "destination": "/support.html" },
    { "source": "/en",       "destination": "/en.html" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}