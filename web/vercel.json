{
  "cleanUrls": false,
  "redirects": [
    { "source": "/uk-ua/", "destination": "/uk-ua", "permanent": true },
    { "source": "/en-us/", "destination": "/en-us", "permanent": true }
  ],
  "rewrites": [
    { "source": "/uk-ua",          "destination": "/uk-ua/index.html" },
    { "source": "/uk-ua/download", "destination": "/uk-ua/download.html" },
    { "source": "/uk-ua/faq",      "destination": "/uk-ua/faq.html" },
    { "source": "/uk-ua/support",  "destination": "/uk-ua/support.html" },
    { "source": "/en-us",          "destination": "/en-us/index.html" },
    { "source": "/en-us/download", "destination": "/en-us/download.html" },
    { "source": "/en-us/faq",      "destination": "/en-us/faq.html" },
    { "source": "/en-us/support",  "destination": "/en-us/support.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/faq",      "destination": "/faq.html" },
    { "source": "/support",  "destination": "/support.html" },
    { "source": "/en",       "destination": "/en.html" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}