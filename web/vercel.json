{
  "version": 2,
  "framework": null,
  "installCommand": "git clone https://github.com/flutter/flutter.git --depth 1 -b stable ../flutter ; ../flutter/bin/flutter --disable-analytics ; ../flutter/bin/flutter pub get",
  "buildCommand": "../flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "trailingSlash": false,

  "redirects": [
    { "source": "/uk-ua/", "destination": "/uk-ua", "permanent": true },
    { "source": "/en-us/", "destination": "/en-us", "permanent": true }
  ],

  "rewrites": [
    
    { "source": "/uk-ua",          "destination": "/uk-ua.html" },
    { "source": "/en-us",          "destination": "/en.html" },

    { "source": "/uk-ua/download", "destination": "/download.html" },
    { "source": "/en-us/download", "destination": "/en-us/download.html" },

    { "source": "/uk-ua/faq",      "destination": "/faq.html" },
    { "source": "/en-us/faq",      "destination": "/en-us/faq.html" },

    { "source": "/uk-ua/updates",  "destination": "/updates.html" },
    { "source": "/en-us/updates",  "destination": "/updates.html" },

    { "source": "/uk-ua/api",      "destination": "/api.html" },
    { "source": "/en-us/api",      "destination": "/api.html" },

    { "source": "/uk-ua/protocol", "destination": "/protocol.html" },
    { "source": "/en-us/protocol", "destination": "/protocol.html" },

    { "source": "/uk-ua/schema",   "destination": "/schema.html" },
    { "source": "/en-us/schema",   "destination": "/schema.html" },

    { "source": "/uk-ua/moderation","destination": "/moderation.html" },
    { "source": "/en-us/moderation","destination": "/moderation.html" },

    { "source": "/uk-ua/support",  "destination": "/support.html" },
    { "source": "/en-us/support",  "destination": "/en-us/support.html" },

    { "source": "/(.*)",           "destination": "/index.html" }
  ]
}