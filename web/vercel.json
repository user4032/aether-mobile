{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/uk-ua/",
      "destination": "/uk-ua",
      "permanent": true
    },
    {
      "source": "/en-us/",
      "destination": "/en-us",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/uk-ua",
      "destination": "/uk-ua.html"
    },
    {
      "source": "/uk-ua/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/uk-ua/download",
      "destination": "/download.html"
    },
    {
      "source": "/uk-ua/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/uk-ua/support",
      "destination": "/support.html"
    },
    {
      "source": "/en-us",
      "destination": "/en-us.html"
    },
    {
      "source": "/en-us/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/en-us/download",
      "destination": "/download.html"
    },
    {
      "source": "/en-us/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/en-us/support",
      "destination": "/support.html"
    },
    {
      "source": "/index",
      "destination": "/"
    }
  ]
}